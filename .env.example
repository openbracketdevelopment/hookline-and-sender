APP_ENV=development
API_KEY=replace-with-openssl-rand-hex-32
DEMO_SIGNING_SECRET=replace-with-a-different-openssl-rand-hex-32
POSTGRES_USER=hookline
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_DB=hookline
DATABASE_URL=postgresql+psycopg://hookline:replace-with-a-local-database-password@db:5432/hookline
TEST_DATABASE_URL=postgresql+psycopg://hookline:replace-with-a-local-database-password@db:5432/hookline_test
REDIS_URL=redis://redis:6379/0
DEMO_RECEIVER_URL=http://receiver:8080/webhooks
ALLOW_INSECURE_DEMO_HTTP=true
MAX_REQUEST_BYTES=262144
REQUEST_TIMEOUT_SECONDS=3
LEASE_MARGIN_SECONDS=10
DEPENDENCY_TIMEOUT_SECONDS=3
DISPATCHER_INTERVAL_SECONDS=2
DISPATCH_COOLDOWN_SECONDS=5
MAX_ATTEMPTS=5
RETRY_BASE_SECONDS=1
RETRY_MAX_SECONDS=30
SIGNATURE_TOLERANCE_SECONDS=300
